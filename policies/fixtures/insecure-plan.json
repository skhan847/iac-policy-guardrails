{
  "format_version": "1.2",
  "terraform_version": "1.16.4",
  "variables": {
    "aws_region": {
      "value": "us-east-2"
    }
  },
  "resource_changes": [
    {
      "address": "aws_security_group.bastion",
      "mode": "managed",
      "type": "aws_security_group",
      "name": "bastion",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "before": null,
        "after": {
          "name": "bastion",
          "tags_all": {
            "environment": "dev"
          },
          "ingress": [
            {
              "cidr_blocks": [
                "0.0.0.0/0"
              ],
              "ipv6_cidr_blocks": [],
              "protocol": "tcp",
              "from_port": 22,
              "to_port": 22,
              "description": "ssh"
            }
          ]
        },
        "after_unknown": {}
      }
    },
    {
      "address": "aws_s3_bucket.uploads",
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "uploads",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "before": null,
        "after": {
          "bucket": "my-uploads",
          "tags_all": {
            "owner": "change-me",
            "environment": "dev",
            "data-classification": "internal",
            "project": "iac-guardrails",
            "managed-by": "terraform"
          }
        },
        "after_unknown": {}
      }
    },
    {
      "address": "aws_s3_bucket_acl.uploads",
      "mode": "managed",
