      "change": {
        "actions": [
          "create"
        ],
        "before": null,
        "after": {
          "name": "deploy",
          "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": \"*\", \"Resource\": \"*\"}]}",
          "tags_all": {
            "owner": "change-me",
            "environment": "dev",
            "data-classification": "internal",
            "project": "iac-guardrails",
            "managed-by": "terraform"
          }
        },
        "after_unknown": {}
      }
