    {
      "address": "aws_iam_access_key.ci",
      "mode": "managed",
      "type": "aws_iam_access_key",
      "name": "ci",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "before": null,
        "after": {
          "user": "ci-bot"
        },
        "after_unknown": {}
      }
