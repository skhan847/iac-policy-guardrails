  "configuration": {
    "provider_config": {
      "aws": {
        "name": "aws",
        "full_name": "registry.terraform.io/hashicorp/aws",
        "expressions": {
          "region": {
            "references": [
              "var.aws_region"
            ]
          }
        }
      }
    }
  }
}